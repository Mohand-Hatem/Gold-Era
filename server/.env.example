# ── Server ───────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Database (Phase 3) ───────────────────────────────────────────────────
# Pooled connection used by the application at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Unpooled connection used by `prisma migrate` (ADR-032). On Neon this is the
# same host without the `-pooler` suffix. Optional: omit when the provider has
# no separate direct host.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth / JWT (Phase 4) ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Seeded admin account (Phase 3) ───────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=Admin123

# ── Email / OTP delivery (Phase 4, ADR-011) ──────────────────────────────
# Nodemailer + Gmail SMTP is the only delivery mechanism.
# SMTP_PASSWORD is a Gmail *App Password* (16 characters, 2FA required) —
# never the account password. Required in production: the server refuses to
# start without SMTP_USER and SMTP_PASSWORD when NODE_ENV=production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Blob storage: Cloudinary (Phase 5, ADR-039) ──────────────────────────
# From the Cloudinary dashboard. Required — the server refuses to start without them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder prefix for uploaded assets.
CLOUDINARY_FOLDER=filox

# ── CORS + cookie behaviour (Phase 2 / Phase 4) ──────────────────────────
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Upload limits (Phase 5) ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=5

# ── OTP policy (Phase 4) ─────────────────────────────────────────────────
OTP_TTL_MINUTES=10

# ── Rate limiting (Phase 4, P1) ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
