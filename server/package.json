{
  "name": "managing-your-files-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express + TypeScript REST API for the Managing Your Files system",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "5.2.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
